# Arkitekten (processritaren) – inställningarna. Kopiera till .env och fyll i.
# Allt läses ur miljön (server/installningar.ts). Servern startar inte om något
# som krävs saknas, och skriver aldrig ut värdena – bara namnen.
# Lägg ALDRIG en ifylld .env i git.

# ── Appen ─────────────────────────────────────────────────────────────────────
# Appens publika adress. Krävs med Entra ID (redirect-URI:n byggs av den) och
# med lokala konton i drift (NODE_ENV=production).
ARK_BAS_URL=https://arkitekten.example.org
# ANTAL betrodda proxyer framför appen (Render, omvänd proxy) som INTE går att
# gå förbi. Klientens adress (inloggningsspärren) tas då ur X-Forwarded-For,
# led nummer n räknat från HÖGER – det som står till vänster kan klienten ha
# skrivit själv. 1 = en proxy (samma som det gamla "1"/"true"/"ja").
# Två proxyer i rad (t.ex. en lastbalanserare framför Caddy) = 2. Tomt/0 = av.
ARK_BETRODD_PROXY=
# Port för webben och /__ark (flödestjänsten har en egen PORT, 8200).
PORT=5173
# Dev-servern (npm run dev) lyssnar bara på 127.0.0.1. Sätt 0.0.0.0 (eller en
# adress) för att nå den från en annan maskin. Gäller inte npm start/avbilden.
ARK_DEV_HOST=
# Delad nyckel mellan flödestjänsten och Integrationsplattformen: varje /api/*-
# anrop till flödestjänsten kräver huvudet X-Arkitekten-Nyckel med samma värde.
# Tomt = ingen nyckel (som förut, varning vid start). Skapa med: openssl rand -hex 32
ARK_FLODESTJANST_NYCKEL=
# Innehållet. I avbilden ligger de i volymen /data.
FLOWS_DIR=/data/flows
RAMAR_DIR=/data/ramar
# Organisationens portalsystem som bana i systemprocesser (standard: Portalen).
ARK_PORTALBANA=
# Katalogens samling för systemprocesser utan egen kategori (standard: Systemprocesser).
ARK_SYSTEMPROCESS_KATEGORI=
# Organisationens namn, kortnamn, logotyp (bildfil: png, jpg, webp eller svg,
# högst 1 MB) och profilfärg (#RRGGBB) i skalet och på inloggningssidan. Tomt =
# portalens inställningar (Administration → Organisation) när EA_API_KEY är
# satt, annars Arkitektens eget.
ARK_ORG_NAMN=
ARK_ORG_KORTNAMN=
ARK_ORG_LOGO=
ARK_ORG_FARG=
# Mall för BMT-exporten: en modellexport (.bmt) ur mål-repositoryt. Utan den visas inte knappen.
ARK_BMT_MALL=
# Symbolstilarna (*.json ur ett innehållspaket) och valet, vald.json.
STILAR_DIR=/data/stilar
ARK_DIR=/data/ark

# ── Inloggning (docs/inloggning.md) ───────────────────────────────────────────
# auto (Entra när uppgifterna finns, annars egna konton), entra, lokal – eller
# dev/oppen för utveckling. Öppen drift (alla är administratörer) startar inte
# i avbilden (NODE_ENV=production) utan ARK_TILLAT_OPPEN=1.
ARK_AUTH=auto
# Engångskod för det första lokala kontot – krävs i drift. Samma som
# portalens och plattformens SETUP_CODE. Skapa med:  openssl rand -hex 16
SETUP_CODE=
# Lokala konton: kontofilen (i avbilden /data/konton.json).
ARK_KONTON=/data/konton.json
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Signerar sessionerna. Minst 32 tecken: openssl rand -hex 32
ARK_SESSION_SECRET=
# Approller i Entra som ger administratör (kommaseparerade).
ENTRA_ADMIN_ROLLER=Arkitekten.Admin,Admin
# Grupper (objekt-id) i Entra vars medlemmar är administratörer.
ENTRA_ADMIN_GRUPPER=
# Reserv: konton (e-post eller oid) som alltid är administratörer.
ARK_ADMINS=

# ── AI-stödet (valfritt) ──────────────────────────────────────────────────────
# Tomt = AI-stödet är av; allt annat fungerar. Nyckeln lämnar aldrig servern.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ARK_AI_MODELL=
# Utvecklarväg: Claude Code besvarar AI-begäranden via brevlådan. Av i drift.
ARK_UTVECKLARLAGE=

# ── Arkitekturportalen (publiceringen, valfritt) ──────────────────────────────
# Tomt = publiceringsknapparna fungerar inte. Processbilderna går ALDRIG den
# här vägen – de hämtas av Integrationsplattformen från flödestjänsten.
EA_API_URL=http://api:8000/api/v1
EA_API_KEY=
EA_WEBB_URL=
